<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} — %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="helpers" level="DEBUG"/>
    <logger name="tests" level="DEBUG"/>
    <logger name="pages" level="DEBUG"/>
    <logger name="driver" level="DEBUG"/>

    <!-- Every request/response to the backend (method, URI, headers, body, status, response body) -->
    <logger name="backend" level="INFO"/>

    <!-- Selenide / RestAssured: reduce noise unless debugging -->
    <logger name="com.codeborne.selenide" level="INFO"/>
    <logger name="io.restassured" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
